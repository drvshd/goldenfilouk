# Copy this file to .dev.vars for local testing (`.dev.vars` is git-ignored — never commit real keys).
# Use TEST keys locally (they start with sk_test_).
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:8788/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: order notification emails (https://resend.com). Leave out to just log orders.
RESEND_API_KEY=re_...
ORDER_EMAIL_TO=goldenfilouk@gmail.com
